# Copy to .env.local and add the same values to Vercel's environment settings.
# Keep existing Resend/contact variables in .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Trailblazers applications: set to true and redeploy to show all application links.
# Missing or any value other than true keeps applications closed.
TRAILBLAZERS_APPLICATIONS_OPEN=false

# Server-only: enable the Google Calendar API and use a publicly readable calendar.
GOOGLE_CALENDAR_API_KEY=YOUR_GOOGLE_CALENDAR_API_KEY
# Optional: defaults to the chapter calendar already used by the website.
GOOGLE_CALENDAR_ID=f302577e7295658f178b08e8f89c746a0996ac9cd8b21b8194d5959b86cf040f@group.calendar.google.com
